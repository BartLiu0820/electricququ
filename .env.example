# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 排除，不会进入 git）
# 命名规则：前缀_API_KEY / 前缀_BASE_URL / 前缀_MODEL 为一组，
# 服务端会自动识别为预设，设置页可一键导入（明文 key 不会下发到浏览器）。

DPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DPSEEK_BASE_URL=https://api.deepseek.com
DPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

ALIYUN_API_KEY=sk-xxxxxxxxxxxxxxxx
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-plus
